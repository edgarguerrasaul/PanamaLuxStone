# ────────────────────────────────────────────────────────────
# Copia este archivo como ".env" y llena los valores reales.
# ".env" nunca se sube a git (ya está en .gitignore) porque
# contiene contraseñas y llaves secretas.
# ────────────────────────────────────────────────────────────

# Base de datos
# En desarrollo local puedes usar SQLite sin configurar nada:
DATABASE_URL="file:./dev.db"
# En producción (Vercel) usa Postgres, por ejemplo Neon o Supabase:
# DATABASE_URL="postgresql://usuario:password@host/base?sslmode=require"

# Dirección pública del sitio (sin / al final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Subida de imágenes ──
# "local"  -> guarda en /public/uploads (solo para desarrollo)
# "cloudinary" -> guarda en la nube, con CDN rápido (recomendado en producción)
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Correos automáticos (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="GUERRA Materiales <ventas@panamaluxstone.com>"
# Contraseña simple para proteger el endpoint del cron de correos
CRON_SECRET="cambia-esto-por-un-texto-largo-y-aleatorio"

# ── Pasarela de pago: Yappy (Banco General) ──
YAPPY_MERCHANT_ID=""
YAPPY_SECRET_KEY=""
YAPPY_ENV="sandbox" # sandbox | production

# ── Pasarela de pago: PagueloFácil / Tilopay (tarjetas en Panamá) ──
PAGUELOFACIL_API_KEY=""
PAGUELOFACIL_ENV="sandbox"

# ── Pasarela de pago: Stripe (clientes internacionales, opcional) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
